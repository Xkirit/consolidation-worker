# Public ntfy server. Change this only when using a self-hosted ntfy instance.
NTFY_SERVER_URL=https://ntfy.sh

# Required. Use a long, private topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=choose-a-long-random-topic-name

# Optional. Required for a protected topic or protected self-hosted server.
# NTFY_TOKEN=tk_your_access_token

# Optional. The same coin is not resent during this rolling window.
CONSOLIDATION_ALERT_COOLDOWN_HOURS=24

# Optional locally. The systemd deployment sets this to persistent VPS storage.
# CONSOLIDATION_ALERT_CACHE_PATH=/var/lib/consolidation-worker/ntfy-cache.json
